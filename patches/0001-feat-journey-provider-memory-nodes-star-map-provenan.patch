+export function getLearningRecallDraft(id: string): Promise<LearningRecallDraft> {
+  return window.hermesDesktop.api<LearningRecallDraft>({
+    ...profileScoped(),
+    path: `/api/learning/recall-draft?id=${encodeURIComponent(id)}`
+  })
+}
+
