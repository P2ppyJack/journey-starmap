+// position, so pulses track drags/zooms for free.
+export function drawSearchPulse({
+  conclusionIds = null,
+  ctx,
+  dpr,
+  matches,
+  nodes,
+  now,
+  palette,
+  vp
+}: {
+  conclusionIds?: null | Set<string>
+  ctx: CanvasRenderingContext2D
+  dpr: number
+  matches: Set<string>
+  nodes: SimNode[]
+  now: number
+  palette: Palette
+  vp: Viewport
+}): void {
+  if (matches.size === 0) {
+    return
+  }
